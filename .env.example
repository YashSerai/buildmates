# Local web origin used by MCP OAuth and production smoke checks.
BUILDMATES_WEB_ORIGIN=http://localhost:3000

# Public MCP origin when apps/mcp is deployed independently.
BUILDMATES_MCP_ORIGIN=http://localhost:8788

# Rotating service assertion keys. Never commit real values.
BUILDMATES_SERVICE_KEY_ID=local-dev
BUILDMATES_SERVICE_PRIVATE_KEY=
BUILDMATES_SERVICE_PUBLIC_KEY=

# Optional GitHub OAuth fallback, activated only when SIWC cannot supply a stable subject.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production smoke target.
BUILDMATES_BASE_URL=

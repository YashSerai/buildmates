{
  "name": "buildmates",
  "version": "0.1.0",
  "private": true,
  "description": "Meet people through what you build.",
  "license": "MIT",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @buildmates/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ignore-pattern **/dist/** --ignore-pattern **/.next/** --ignore-pattern **/.vinext/** --ignore-pattern **/.wrangler/**",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:web && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:security",
    "test:web": "npm run test --workspace @buildmates/web",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests tests/unit packages",
    "test:integration": "vitest run --config vitest.config.ts --passWithNoTests --maxWorkers=2 tests/integration",
    "test:contract": "vitest run --config vitest.config.ts --passWithNoTests --maxWorkers=1 --fileParallelism=false tests/contract",
    "test:security": "vitest run --config vitest.config.ts --passWithNoTests tests/security",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "npm run db:generate --workspace @buildmates/web",
    "db:migrate:local": "npm run db:migrate:local --workspace @buildmates/web",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "plugin:sync": "node plugin/scripts/package-plugin.mjs --sync",
    "plugin:check": "node plugin/scripts/package-plugin.mjs --check",
    "plugin:package": "node plugin/scripts/package-plugin.mjs --package"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.19",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "miniflare": "4.20260710.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "1.31.1"
  }
}
